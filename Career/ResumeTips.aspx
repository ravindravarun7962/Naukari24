<%@ Page Title="" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="ResumeTips.aspx.cs" Inherits="Success24_Job_Portal.ResumeTips" %>
<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="MainContent" runat="server">
    <div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold">
            Resume Writing Tips
        </h1>

        <p class="text-muted">
            Create a professional resume that helps
            recruiters notice your profile.
        </p>

    </div>


    <!-- TIP 1 -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h3>
                1. Keep Your Resume Short
            </h3>

            <p>
                Freshers should keep their resume
                within 1 page and experienced
                candidates within 2 pages.
            </p>

        </div>

    </div>


    <!-- TIP 2 -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h3>
                2. Use a Professional Format
            </h3>

            <p>
                Use clear headings, proper spacing,
                and easy-to-read fonts.
            </p>

        </div>

    </div>


    <!-- TIP 3 -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h3>
                3. Highlight Key Skills
            </h3>

            <p>
                Mention technical and soft skills
                relevant to the job role.
            </p>

        </div>

    </div>


    <!-- TIP 4 -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h3>
                4. Add Projects
            </h3>

            <p>
                Include academic and real-world
                projects with technologies used.
            </p>

        </div>

    </div>


    <!-- TIP 5 -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h3>
                5. Customize for Each Job
            </h3>

            <p>
                Update your resume according to
                the job description and required
                skills.
            </p>

        </div>

    </div>


    <!-- TIP 6 -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h3>
                6. Use Keywords
            </h3>

            <p>
                Recruiters and ATS systems search
                resumes using keywords.
            </p>

        </div>

    </div>


    <!-- TIP 7 -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h3>
                7. Avoid Spelling Mistakes
            </h3>

            <p>
                Always proofread your resume before
                applying for jobs.
            </p>

        </div>

    </div>


    <!-- TIP 8 -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h3>
                8. Keep Contact Information Updated
            </h3>

            <p>
                Make sure your phone number,
                email address and LinkedIn profile
                are correct.
            </p>

        </div>

    </div>

</div>

</asp:Content>
<asp:Content ID="Content3" ContentPlaceHolderID="ScriptsContent" runat="server">
</asp:Content>
