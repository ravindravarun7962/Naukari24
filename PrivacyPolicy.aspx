<%@ Page Title="" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="PrivacyPolicy.aspx.cs" Inherits="Success24_Job_Portal.PrivacyPolicy" %>
<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
      <style>

        .legal-page {
            padding: 50px 20px;
            background: #f8fafc;
        }

        .legal-container {
            max-width: 1000px;
            margin: 0 auto;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            padding: 40px;
        }

        .legal-header {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid #e5e7eb;
        }

        .legal-header h1 {
            margin: 0 0 10px;
            font-size: 32px;
            font-weight: 700;
            color: #111827;
        }

        .legal-header p {
            margin: 0;
            color: #6b7280;
            font-size: 14px;
        }

        .legal-section {
            margin-bottom: 30px;
        }

        .legal-section h2 {
            margin: 0 0 12px;
            font-size: 20px;
            font-weight: 700;
            color: #111827;
        }

        .legal-section h3 {
            margin: 18px 0 8px;
            font-size: 16px;
            font-weight: 600;
            color: #1f2937;
        }

        .legal-section p {
            margin: 0 0 12px;
            font-size: 14px;
            line-height: 1.8;
            color: #4b5563;
        }

        .legal-section ul {
            margin: 10px 0 15px 20px;
            padding: 0;
        }

        .legal-section li {
            margin-bottom: 8px;
            font-size: 14px;
            line-height: 1.7;
            color: #4b5563;
        }

        .legal-highlight {
            padding: 15px 18px;
            background: #f9fafb;
            border-left: 4px solid #111827;
            border-radius: 6px;
            margin: 15px 0;
        }

        @media (max-width: 768px) {

            .legal-page {
                padding: 25px 15px;
            }

            .legal-container {
                padding: 25px 20px;
            }

            .legal-header h1 {
                font-size: 26px;
            }

            .legal-section h2 {
                font-size: 18px;
            }

        }

    </style>

</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="MainContent" runat="server">
     <div class="legal-page">

        <div class="legal-container">

            <div class="legal-header">

                <h1>Privacy Policy</h1>

                <p>
                    Last Updated: September 12, 2026
                </p>

            </div>


            <div class="legal-section">

                <h2>1. Introduction</h2>

                <p>
                    Welcome to Naukari24 Job Portal. We respect your privacy
                    and are committed to protecting the personal information
                    you provide while using our website and services.
                </p>

                <p>
                    This Privacy Policy explains how we collect, use,
                    store and protect information when you access or use
                    the Naukari24 Job Portal.
                </p>

            </div>


            <div class="legal-section">

                <h2>2. Information We Collect</h2>

                <p>
                    We may collect information that you voluntarily provide
                    when creating an account, applying for jobs, posting jobs
                    or contacting us.
                </p>

                <h3>For Job Seekers</h3>

                <ul>
                    <li>Full name</li>
                    <li>Email address</li>
                    <li>Mobile number</li>
                    <li>Location information</li>
                    <li>Education details</li>
                    <li>Professional experience</li>
                    <li>Skills</li>
                    <li>Resume and other uploaded documents</li>
                    <li>Job application information</li>
                </ul>

                <h3>For Recruiters</h3>

                <ul>
                    <li>Name and contact information</li>
                    <li>Company information</li>
                    <li>Job posting information</li>
                    <li>Recruitment and application-related information</li>
                </ul>

            </div>


            <div class="legal-section">

                <h2>3. How We Use Your Information</h2>

                <p>
                    We may use collected information to:
                </p>

                <ul>
                    <li>Create and manage user accounts.</li>
                    <li>Provide job search and recruitment services.</li>
                    <li>Process job applications.</li>
                    <li>Allow recruiters to review applications.</li>
                    <li>Improve our website and services.</li>
                    <li>Communicate important service-related information.</li>
                    <li>Maintain security and prevent unauthorized activity.</li>
                </ul>

            </div>


            <div class="legal-section">

                <h2>4. Resume and Profile Information</h2>

                <p>
                    Job seekers may upload resumes and provide professional
                    information to apply for job opportunities.
                </p>

                <p>
                    Information contained in a job seeker's profile or resume
                    may be made available to recruiters where necessary for
                    recruitment-related activities.
                </p>

            </div>


            <div class="legal-section">

                <h2>5. Information Sharing</h2>

                <p>
                    We do not sell or rent personal information to third
                    parties for their own marketing purposes.
                </p>

                <p>
                    Information may be shared with relevant recruiters,
                    service providers or other parties where necessary to
                    provide the services of the Job Portal or comply with
                    applicable legal requirements.
                </p>

            </div>


            <div class="legal-section">

                <h2>6. Data Security</h2>

                <p>
                    We take reasonable measures to protect your information
                    against unauthorized access, alteration, disclosure or
                    destruction.
                </p>

                <div class="legal-highlight">

                    However, no internet-based service can guarantee complete
                    security of information.

                </div>

            </div>


            <div class="legal-section">

                <h2>7. Cookies</h2>

                <p>
                    We may use cookies and similar technologies to improve
                    website functionality, remember preferences and understand
                    how users interact with our services.
                </p>

            </div>


            <div class="legal-section">

                <h2>8. Account Information</h2>

                <p>
                    You are responsible for keeping your account credentials
                    confidential and for activities performed through your
                    account.
                </p>

            </div>


            <div class="legal-section">

                <h2>9. Your Rights</h2>

                <p>
                    Depending on applicable laws, you may have rights to
                    access, update or request deletion of certain personal
                    information associated with your account.
                </p>

            </div>


            <div class="legal-section">

                <h2>10. Changes to This Privacy Policy</h2>

                <p>
                    We may update this Privacy Policy from time to time.
                    Changes will be posted on this page with an updated
                    revision date.
                </p>

            </div>


            <div class="legal-section">

                <h2>11. Contact Us</h2>

                <p>
                    If you have questions regarding this Privacy Policy,
                    please contact Naukari24 Job Portal through the contact
                    information provided on our website.
                </p>

            </div>

        </div>

    </div>
</asp:Content>
<asp:Content ID="Content3" ContentPlaceHolderID="ScriptsContent" runat="server">
</asp:Content>
