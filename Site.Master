<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Success24_Job_Portal.Site" %>
<!DOCTYPE html>

<html lang="en">
<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        <%: Page.Title %> | NAUKARI24
    </title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />

    <!-- Google Font -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin="anonymous" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <!-- Main CSS -->
    <link href="<%= ResolveUrl("~/Assets/css/site.css") %>"
          rel="stylesheet" />
       <link href="<%= ResolveUrl("~/Assets/css/site.css") %>"
         rel="stylesheet" />
         <link href="<%= ResolveUrl("~/Assets/css/edit-profile.css") %>"
         rel="stylesheet" />

    <asp:ContentPlaceHolder
        ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>

<form id="form1" runat="server">

    <!-- ========================================
         HEADER / NAVBAR
    ========================================= -->

    <header class="main-header">

        <nav class="navbar navbar-expand-lg navbar-light">

            <div class="container">

                <!-- Logo -->

                <a class="navbar-brand success-logo"
                   href="<%= ResolveUrl("~/Default.aspx") %>">

                    <span class="logo-success">
                        NAUKARI
                    </span><span class="logo-24">24</span>

                </a>


                <!-- Mobile Toggle -->

                <button class="navbar-toggler border-0 shadow-none"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Navigation -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 main-nav">

                        <li class="nav-item">

                            <a class="nav-link"
                               href="<%= ResolveUrl("~/Jobs.aspx") %>">

                                Jobs

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               href="<%= ResolveUrl("~/Companies.aspx") %>">

                                Companies

                            </a>

                        </li>


                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                Career Resources

                            </a>

                            <ul class="dropdown-menu">

                                <li>

                                    <a class="dropdown-item"
                                       href="<%= ResolveUrl("~/Career/ResumeTips.aspx") %>">

                                        Resume Tips

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item"
                                       href="<%= ResolveUrl("~/Career/InterviewTips.aspx") %>">

                                        Interview Tips

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item"
                                       href="<%= ResolveUrl("~/Career/CareerAdvice.aspx") %>">

                                        Career Advice

                                    </a>

                                </li>

                            </ul>

                        </li>

                    </ul>


                    <!-- Right Side Buttons -->

                    <div class="nav-actions d-flex align-items-center gap-2">

                        <a href="<%= ResolveUrl("~/Login.aspx") %>"
                           class="btn btn-login">

                            Login

                        </a>


                        <a href="<%= ResolveUrl("~/Register.aspx") %>"
                           class="btn btn-register">

                            Register

                        </a>


                        <div class="employer-divider d-none d-lg-block"></div>


                        <a href="<%= ResolveUrl("~/Recruiter/RecruiterRegister.aspx") %>"
                           class="btn btn-employer">

                            <i class="bi bi-building me-1"></i>

                            For Employers

                        </a>

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <!-- ========================================
         PAGE CONTENT
    ========================================= -->

    <main class="page-content">

        <asp:ContentPlaceHolder
            ID="MainContent"
            runat="server">
        </asp:ContentPlaceHolder>

    </main>


    <!-- ========================================
         FOOTER
    ========================================= -->

    <footer class="main-footer">

        <div class="container">

            <div class="row g-4">

                <!-- Company -->

                <div class="col-lg-4 col-md-6">

                    <a class="footer-logo"
                       href="<%= ResolveUrl("~/Default.aspx") %>">

                        <span class="logo-success text-white">
                            NAUKARI
                        </span><span class="logo-24">24</span>

                    </a>

                    <p class="footer-description">

                        Find the right job, connect with trusted
                        employers and build your career with NAUKARI24.

                    </p>


                    <div class="social-links">

                        <a href="#"
                           aria-label="LinkedIn">

                            <i class="bi bi-linkedin"></i>

                        </a>

                        <a href="#"
                           aria-label="Facebook">

                            <i class="bi bi-facebook"></i>

                        </a>

                        <a href="#"
                           aria-label="Instagram">

                            <i class="bi bi-instagram"></i>

                        </a>

                        <a href="#"
                           aria-label="Twitter">

                            <i class="bi bi-twitter-x"></i>

                        </a>

                    </div>

                </div>


                <!-- Job Seekers -->

                <div class="col-lg-2 col-md-6">

                    <h5 class="footer-title">
                        Job Seekers
                    </h5>

                    <ul class="footer-links">

                        <li>
                            <a href="<%= ResolveUrl("~/Jobs.aspx") %>">
                                Browse Jobs
                            </a>
                        </li>

                        <li>
                            <a href="<%= ResolveUrl("~/Companies.aspx") %>">
                                Companies
                            </a>
                        </li>

                        <li>
                            <a href="<%= ResolveUrl("~/Register.aspx") %>">
                                Create Profile
                            </a>
                        </li>

                        <li>
                            <a href="<%= ResolveUrl("~/Login.aspx") %>">
                                Login
                            </a>
                        </li>

                    </ul>

                </div>


                <!-- Employers -->

                <div class="col-lg-3 col-md-6">

                    <h5 class="footer-title">
                        Employers
                    </h5>

                    <ul class="footer-links">

                        <li>
                            <a href="<%= ResolveUrl("~/Recruiter/RecruiterRegister.aspx") %>">
                                Register as Employer
                            </a>
                        </li>

                        <li>
                            <a href="<%= ResolveUrl("~/Login.aspx") %>">
                                Recruiter Login
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                Post a Job
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                Search Candidates
                            </a>
                        </li>

                    </ul>

                </div>


                <!-- Support -->

                <div class="col-lg-3 col-md-6">

                    <h5 class="footer-title">
                        Support
                    </h5>

                    <ul class="footer-links">

                        <li>
                            <a href="#">
                                About Us
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                Contact Us
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                Privacy Policy
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                Terms & Conditions
                            </a>
                        </li>

                    </ul>

                </div>

            </div>


            <div class="footer-bottom">

                <div class="row align-items-center">

                    <div class="col-md-6">

                        <p class="mb-0">

                            © <%: DateTime.Now.Year %> NAUKARI24.
                            All Rights Reserved.

                        </p>

                    </div>

                    <div class="col-md-6 text-md-end mt-2 mt-md-0">

                        <span>
                            Connecting talent with opportunity.
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </footer>

</form>


<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
</script>


<asp:ContentPlaceHolder
    ID="ScriptsContent"
    runat="server">
</asp:ContentPlaceHolder>

</body>

</html>