<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Recruiter.master.cs" Inherits="Success24_Job_Portal.Recruiter.Recruiter" %>

<!DOCTYPE html>

<html lang="en">

<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>

        <asp:ContentPlaceHolder
            ID="TitleContent"
            runat="server">
        </asp:ContentPlaceHolder>

        - Recruiter Portal

    </title>


    <!-- Bootstrap Icons -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <style>

        /* =========================================================
           RESET
        ========================================================= */

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }


        html {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }


        body {
            margin: 0;
            padding: 0;

            min-height: 100vh;

            font-family:
                "Segoe UI",
                Arial,
                sans-serif;

            background: #f6f7fb;

            color: #111827;
        }


        /* =========================================================
           MAIN APPLICATION LAYOUT
        ========================================================= */

        .recruiter-layout {
            min-height: 100vh;

            display: flex;
        }


        /* =========================================================
           SIDEBAR
        ========================================================= */

        .recruiter-sidebar {

            position: fixed;

            left: 0;
            top: 0;
            bottom: 0;

            width: 250px;

            background: #111827;

            color: #ffffff;

            z-index: 2000;

            display: flex;
            flex-direction: column;

            overflow-y: auto;
        }


        /* =========================================================
           SIDEBAR BRAND
        ========================================================= */

        .recruiter-brand {

            height: 72px;

            flex-shrink: 0;

            display: flex;
            align-items: center;

            padding: 0 22px;

            border-bottom:
                1px solid
                rgba(255,255,255,.08);
        }


        .recruiter-brand-icon {

            width: 38px;
            height: 38px;

            flex-shrink: 0;

            border-radius: 10px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #ffffff;

            color: #111827;

            font-size: 19px;

            margin-right: 11px;
        }


        .recruiter-brand-text {

            font-size: 17px;

            font-weight: 700;

            color: #ffffff;
        }


        .recruiter-brand-subtitle {

            display: block;

            margin-top: 2px;

            font-size: 10px;

            color: #9ca3af;
        }


        /* =========================================================
           NAVIGATION
        ========================================================= */

        .recruiter-nav {

            flex: 1;

            padding: 20px 12px;
        }


        .recruiter-nav-title {

            padding:
                0 12px
                8px;

            font-size: 10px;

            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: 1px;

            color: #6b7280;
        }


        .recruiter-nav-link {

            display: flex;

            align-items: center;

            gap: 12px;

            width: 100%;

            padding: 11px 12px;

            margin-bottom: 4px;

            border: 0;

            border-radius: 9px;

            background: transparent;

            color: #d1d5db;

            text-decoration: none;

            font-family: inherit;

            font-size: 14px;

            text-align: left;

            cursor: pointer;

            transition:
                background .2s ease,
                color .2s ease;
        }


        .recruiter-nav-link i {

            width: 20px;

            flex-shrink: 0;

            text-align: center;

            font-size: 17px;
        }


        .recruiter-nav-link:hover {

            background:
                rgba(255,255,255,.07);

            color: #ffffff;
        }


        .recruiter-nav-link.active {

            background: #ffffff;

            color: #111827;

            font-weight: 600;
        }


        /* =========================================================
           SIDEBAR FOOTER
        ========================================================= */

        .recruiter-sidebar-footer {

            flex-shrink: 0;

            padding: 15px;

            border-top:
                1px solid
                rgba(255,255,255,.08);
        }


        .recruiter-user {

            display: flex;

            align-items: center;

            gap: 10px;

            padding: 9px;
        }


        .recruiter-user-avatar {

            width: 36px;
            height: 36px;

            flex-shrink: 0;

            border-radius: 50%;

            background: #374151;

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 13px;

            font-weight: 700;
        }


        .recruiter-user-info {

            min-width: 0;
        }


        .recruiter-user-name {

            display: block;

            color: #ffffff;

            font-size: 13px;

            font-weight: 600;

            white-space: nowrap;

            overflow: hidden;

            text-overflow: ellipsis;
        }


        .recruiter-user-role {

            display: block;

            color: #9ca3af;

            font-size: 11px;
        }


        /* =========================================================
           MAIN
        ========================================================= */

        .recruiter-main {

            margin-left: 250px;

            width: calc(100% - 250px);

            min-height: 100vh;

            display: flex;

            flex-direction: column;
        }


        /* =========================================================
           TOP HEADER
        ========================================================= */

        .recruiter-topbar {

            height: 72px;

            flex-shrink: 0;

            background: #ffffff;

            border-bottom:
                1px solid
                #e5e7eb;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 0 28px;

            position: sticky;

            top: 0;

            z-index: 1000;
        }


        .recruiter-topbar-left {

            display: flex;

            align-items: center;

            gap: 12px;

            min-width: 0;
        }


        .recruiter-page-title {

            font-size: 18px;

            font-weight: 700;

            color: #111827;

            white-space: nowrap;

            overflow: hidden;

            text-overflow: ellipsis;
        }


        /* =========================================================
           MENU BUTTON
        ========================================================= */

        .recruiter-menu-btn {

            display: none;

            width: 40px;
            height: 40px;

            border: 1px solid #e5e7eb;

            border-radius: 9px;

            background: #ffffff;

            color: #111827;

            font-size: 21px;

            cursor: pointer;
        }


        /* =========================================================
           TOP RIGHT
        ========================================================= */

        .recruiter-topbar-right {

            display: flex;

            align-items: center;

            gap: 12px;
        }


        .recruiter-notification {

            width: 40px;
            height: 40px;

            border: 1px solid #e5e7eb;

            border-radius: 9px;

            display: flex;

            align-items: center;
            justify-content: center;

            color: #4b5563;

            background: #ffffff;

            text-decoration: none;

            transition:
                background .2s ease,
                color .2s ease;
        }


        .recruiter-notification:hover {

            background: #f9fafb;

            color: #111827;
        }


        .recruiter-profile {

            display: flex;

            align-items: center;

            gap: 9px;

            padding-left: 12px;

            border-left:
                1px solid
                #e5e7eb;
        }


        .recruiter-profile-avatar {

            width: 36px;
            height: 36px;

            flex-shrink: 0;

            border-radius: 50%;

            display: flex;

            align-items: center;
            justify-content: center;

            background: #f3f4f6;

            color: #374151;

            font-size: 13px;

            font-weight: 700;
        }


        .recruiter-profile-name {

            display: block;

            font-size: 13px;

            font-weight: 600;

            color: #111827;
        }


        .recruiter-profile-role {

            display: block;

            font-size: 10px;

            color: #9ca3af;
        }


        /* =========================================================
           PAGE CONTENT
        ========================================================= */

        .recruiter-content {

            flex: 1;

            width: 100%;

            min-width: 0;
        }


        /* =========================================================
           PAGE FOOTER
        ========================================================= */

        .recruiter-footer {

            flex-shrink: 0;

            min-height: 55px;

            background: #ffffff;

            border-top:
                1px solid
                #e5e7eb;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 12px 28px;

            color: #6b7280;

            font-size: 11px;
        }


        .recruiter-footer-left {

            color: #6b7280;
        }


        .recruiter-footer-right {

            display: flex;

            gap: 18px;
        }


        .recruiter-footer-right a {

            color: #6b7280;

            text-decoration: none;
        }


        .recruiter-footer-right a:hover {

            color: #111827;
        }


        /* =========================================================
           MOBILE OVERLAY
        ========================================================= */

        .recruiter-overlay {

            display: none;

            position: fixed;

            inset: 0;

            background:
                rgba(0,0,0,.45);

            z-index: 1500;
        }


        .recruiter-overlay.show {

            display: block;
        }


        /* =========================================================
           TABLET
        ========================================================= */

        @media (max-width: 900px) {

            .recruiter-sidebar {

                transform:
                    translateX(-100%);

                transition:
                    transform .25s ease;
            }


            .recruiter-sidebar.open {

                transform:
                    translateX(0);
            }


            .recruiter-main {

                margin-left: 0;

                width: 100%;
            }


            .recruiter-menu-btn {

                display: flex;

                align-items: center;

                justify-content: center;
            }


            .recruiter-topbar {

                padding:
                    0 16px;
            }


            .recruiter-profile-name,
            .recruiter-profile-role {

                display: none;
            }


            .recruiter-footer {

                padding:
                    12px 16px;
            }
        }


        /* =========================================================
           MOBILE
        ========================================================= */

        @media (max-width: 600px) {

            .recruiter-topbar {

                height: 64px;
            }


            .recruiter-page-title {

                font-size: 16px;
            }


            .recruiter-topbar-right {

                gap: 7px;
            }


            .recruiter-notification {

                width: 36px;
                height: 36px;
            }


            .recruiter-profile {

                padding-left: 7px;
            }


            .recruiter-footer {

                flex-direction: column;

                align-items: center;

                justify-content: center;

                gap: 6px;

                text-align: center;
            }


            .recruiter-footer-right {

                gap: 12px;
            }
        }


        @media (max-width: 500px) {

            .recruiter-sidebar {

                width: 270px;
            }
        }

    </style>


    <!-- PAGE-SPECIFIC HEAD CONTENT -->

    <asp:ContentPlaceHolder
        ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

</head>


<body>


<form
    id="form1"
    runat="server">


    <!-- =========================================================
         APPLICATION LAYOUT
    ========================================================== -->

    <div class="recruiter-layout">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside
            id="recruiterSidebar"
            runat="server"
            class="recruiter-sidebar">


            <!-- BRAND -->

            <div class="recruiter-brand">

                <div class="recruiter-brand-icon">

                    <i class="bi bi-briefcase-fill"></i>

                </div>


                <div>

                    <div class="recruiter-brand-text">
                        Naukari24
                    </div>

                    <span class="recruiter-brand-subtitle">
                        Recruiter Portal
                    </span>

                </div>

            </div>


            <!-- NAVIGATION -->

            <nav class="recruiter-nav">


                <div class="recruiter-nav-title">
                    Recruitment
                </div>


                <a
                    href="<%= ResolveUrl("~/Recruiter/Dashboard.aspx") %>"
                    class="recruiter-nav-link">

                    <i class="bi bi-grid-1x2"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <a
                    href="<%= ResolveUrl("~/Recruiter/Jobs.aspx") %>"
                    class="recruiter-nav-link">

                    <i class="bi bi-briefcase"></i>

                    <span>
                        My Posted Jobs
                    </span>

                </a>


                <a
                    href="<%= ResolveUrl("~/Recruiter/JobPost.aspx") %>"
                    class="recruiter-nav-link">

                    <i class="bi bi-plus-circle"></i>

                    <span>
                        Post a Job
                    </span>

                </a>


                <a
                    href="<%= ResolveUrl("~/Recruiter/Applications.aspx") %>"
                    class="recruiter-nav-link">

                    <i class="bi bi-people"></i>

                    <span>
                        Applications
                    </span>

                </a>


                <a
                    href="<%= ResolveUrl("~/Recruiter/CompanyProfile.aspx") %>"
                    class="recruiter-nav-link">

                    <i class="bi bi-building"></i>

                    <span>
                        Company Profile
                    </span>

                </a>


                <a
                    href="<%= ResolveUrl("~/Companies.aspx") %>"
                    class="recruiter-nav-link">

                    <i class="bi bi-building-add"></i>

                    <span>
                        Add Company
                    </span>

                </a>


                <div
                    class="recruiter-nav-title"
                    style="margin-top:22px;">

                    Account

                </div>


                <a
                    href="<%= ResolveUrl("~/Recruiter/Profile.aspx") %>"
                    class="recruiter-nav-link">

                    <i class="bi bi-person"></i>

                    <span>
                        My Profile
                    </span>

                </a>


                <asp:LinkButton
                    ID="lnkLogout"
                    runat="server"
                    CssClass="recruiter-nav-link"
                    OnClick="lnkLogout_Click">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </asp:LinkButton>


            </nav>


            <!-- SIDEBAR USER -->

            <div class="recruiter-sidebar-footer">

                <div class="recruiter-user">


                    <div class="recruiter-user-avatar">

                        <asp:Label
                            ID="lblUserInitial"
                            runat="server"
                            Text="R">
                        </asp:Label>

                    </div>


                    <div class="recruiter-user-info">

                        <span
                            class="recruiter-user-name">

                            <asp:Label
                                ID="lblRecruiterName"
                                runat="server"
                                Text="Recruiter">
                            </asp:Label>

                        </span>


                        <span
                            class="recruiter-user-role">

                            Recruiter

                        </span>

                    </div>


                </div>

            </div>


        </aside>


        <!-- =====================================================
             MOBILE OVERLAY
        ====================================================== -->

        <div
            id="recruiterOverlay"
            runat="server"
            class="recruiter-overlay">
        </div>


        <!-- =====================================================
             MAIN CONTENT AREA
        ====================================================== -->

        <main
            id="recruiterMain"
            runat="server"
            class="recruiter-main">


            <!-- =================================================
                 TOP HEADER
            ================================================== -->

            <header
                id="recruiterTopbar"
                runat="server"
                class="recruiter-topbar">


                <div class="recruiter-topbar-left">


                    <!-- MOBILE MENU -->

                    <button
                        type="button"
                        id="recruiterMenuBtn"
                        class="recruiter-menu-btn">

                        <i class="bi bi-list"></i>

                    </button>


                    <!-- PAGE TITLE -->

                    <span
                        class="recruiter-page-title">

                        <asp:ContentPlaceHolder
                            ID="PageTitle"
                            runat="server">

                            Recruiter Dashboard

                        </asp:ContentPlaceHolder>

                    </span>


                </div>


                <!-- TOP RIGHT -->

                <div class="recruiter-topbar-right">


                    <a
                        href="#"
                        class="recruiter-notification"
                        title="Notifications">

                        <i class="bi bi-bell"></i>

                    </a>


                    <div class="recruiter-profile">


                        <div class="recruiter-profile-avatar">

                            <asp:Label
                                ID="lblTopInitial"
                                runat="server"
                                Text="R">
                            </asp:Label>

                        </div>


                        <div>

                            <span
                                class="recruiter-profile-name">

                                <asp:Label
                                    ID="lblTopRecruiterName"
                                    runat="server"
                                    Text="Recruiter">
                                </asp:Label>

                            </span>


                            <span
                                class="recruiter-profile-role">

                                Recruiter

                            </span>

                        </div>


                    </div>


                </div>


            </header>


            <!-- =================================================
                 PAGE CONTENT
            ================================================== -->

            <div class="recruiter-content">

                <asp:ContentPlaceHolder
                    ID="MainContent"
                    runat="server">
                </asp:ContentPlaceHolder>

            </div>


            <!-- =================================================
                 PAGE FOOTER
            ================================================== -->

            <footer class="recruiter-footer">


                <div class="recruiter-footer-left">

                    © <%: DateTime.Now.Year %>
                    Naukari24. All rights reserved.

                </div>
                             

            </footer>


        </main>


    </div>


    <!-- =========================================================
         MASTER PAGE JAVASCRIPT
    ========================================================== -->

    <script type="text/javascript">

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                var menuButton =
                    document.getElementById(
                        "recruiterMenuBtn"
                    );

                var sidebar =
                    document.getElementById(
                        "<%= recruiterSidebar.ClientID %>"
                    );

                var overlay =
                    document.getElementById(
                        "<%= recruiterOverlay.ClientID %>"
                    );


                if (
                    !menuButton ||
                    !sidebar ||
                    !overlay
                ) {

                    return;
                }


                /* OPEN SIDEBAR */

                menuButton.addEventListener(
                    "click",
                    function () {

                        sidebar.classList.add("open");

                        overlay.classList.add("show");

                    }
                );


                /* CLOSE SIDEBAR */

                overlay.addEventListener(
                    "click",
                    function () {

                        sidebar.classList.remove("open");

                        overlay.classList.remove("show");

                    }
                );


                /* CLOSE AFTER NAVIGATION */

                var links =
                    sidebar.querySelectorAll(
                        "a, button"
                    );


                links.forEach(
                    function (link) {

                        link.addEventListener(
                            "click",
                            function () {

                                if (
                                    window.innerWidth <= 900
                                ) {

                                    sidebar.classList.remove(
                                        "open"
                                    );

                                    overlay.classList.remove(
                                        "show"
                                    );

                                }

                            }
                        );

                    }
                );

            }
        );

    </script>


    <!-- PAGE-SPECIFIC SCRIPTS -->

    <asp:ContentPlaceHolder
        ID="ScriptsContent"
        runat="server">
    </asp:ContentPlaceHolder>


</form>

</body>

</html>